# ============================================================
# ForecastGuard — .gitignore
# ============================================================

# ----- Python -----
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
dist/
build/
.eggs/
*.whl

# Virtual environments
venv/
.venv/
env/
ENV/
.env/

# ----- Node / Frontend -----
node_modules/

# Local bundled Node.js (not needed in repo — Render/Vercel provide their own)
nodejs/

# Frontend build output (Vercel builds from source)
frontend/dist/

# ----- Environment files (NEVER commit secrets) -----
.env
.env.local
.env.production
.env.production.local
.env.development.local
.env.test.local

# ----- Testing & Coverage -----
.pytest_cache/
htmlcov/
.coverage
coverage.xml
coverage/
*.lcov

# ----- Caches -----
.cache/
*.cache
.ruff_cache/
.mypy_cache/

# ----- OS files -----
.DS_Store
Thumbs.db
desktop.ini

# ----- Logs -----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ----- Editor -----
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ----- Miscellaneous -----
*.zip
*.tar.gz

# NOTE: The trained ML model (*.joblib) and research CSVs are intentionally
# INCLUDED in the repository.  They are small (< 5 MB total) and are the
# core research artifacts that must travel with the codebase.
# DO NOT add *.joblib or *.csv to this file.

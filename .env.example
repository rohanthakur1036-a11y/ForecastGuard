# ============================================================
# ForecastGuard — Root .env.example
# ============================================================
# This file documents every environment variable used by the project.
# Copy the relevant section to backend/.env or frontend/.env.local
# and fill in real values.  NEVER commit files without the .example suffix.

# ---- Backend (backend/.env) ----

# Comma-separated list of frontend origins allowed to call the API.
# In production set this to your actual Vercel URL.
# Example: https://forecastguard.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Port uvicorn listens on (Render sets $PORT automatically).
PORT=8000

# ---- Frontend (frontend/.env.local) ----

# Full URL of the deployed backend (no trailing slash).
# Leave empty in local development — the Vite proxy handles it.
# Example: https://forecastguard-api.onrender.com
VITE_API_URL=

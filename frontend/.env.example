# ============================================================
# ForecastGuard Frontend — Environment Variables
# ============================================================
# Copy this file to .env.local for local development.
# In production (Vercel), set these in the Vercel dashboard.

# URL of the deployed FastAPI backend.
# Leave EMPTY in local development (Vite dev-server proxy handles /api → localhost:8000).
# In production set this to your Render backend URL, e.g.:
#   VITE_API_URL=https://forecastguard-api.onrender.com
VITE_API_URL=
